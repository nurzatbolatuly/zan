# Пример конфигурации helper/ — тестовые значения для локальной разработки.
# Скопировать в .env (он в .gitignore, не коммитится). На хостинге те же
# переменные задаются в панели сервиса. [ЗАМЕНИТЬ] — реальные значения только
# в .env/панели хостинга.

ENV=dev
GRPC_PORT=9090
HEALTH_HTTP_PORT=8001
LOG_LEVEL=info

# [ЗАМЕНИТЬ] `openssl rand -hex 32` — буквально то же значение, что
# INTERNAL_SECRET backend/.
INTERNAL_SECRET=test_internal_secret_0000000000000000000000000000000000

# --- S3-совместимое хранилище (локально — MinIO), те же, что у backend/ ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# [ЗАМЕНИТЬ] ключи доступа к хранилищу.
S3_ACCESS_KEY=test_access_key
S3_SECRET_KEY=test_secret_key
S3_BUCKET=zan-files

# faster-whisper: tiny — быстрый старт локально; в проде small/medium.
WHISPER_MODEL_SIZE=tiny
