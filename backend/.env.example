# Пример конфигурации backend/ — тестовые значения для локальной разработки.
# Скопировать в .env (он в .gitignore, не коммитится). На хостинге те же
# переменные задаются в панели сервиса. Всё с пометкой [ЗАМЕНИТЬ] — реальные
# значения только в .env/панели хостинга, никогда в этом файле.

ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- Postgres (роль zan_core) ---
DATABASE_URL=postgres://zan_core:test_password@localhost:5432/zan?sslmode=disable

# --- Секреты приложения: 32+ символов ---
# [ЗАМЕНИТЬ] каждое значение на вывод `openssl rand -hex 32`.
# INTERNAL_SECRET должен совпадать с INTERNAL_SECRET helper/.
ADMIN_TOKEN=test_admin_token_0000000000000000000000000000000000000000
SESSION_HMAC_SECRET=test_session_hmac_secret_000000000000000000000000000000
INTERNAL_SECRET=test_internal_secret_0000000000000000000000000000000000

# --- S3-совместимое хранилище (локально — MinIO) ---
S3_ENDPOINT=http://localhost:9000
# Адрес, достижимый из браузера; пусто — тот же, что S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# [ЗАМЕНИТЬ] ключи доступа к хранилищу.
S3_ACCESS_KEY=test_access_key
S3_SECRET_KEY=test_secret_key
S3_BUCKET=zan-files

# --- Лимиты загрузки (байты, 15 МБ) ---
# FILE_MAX_SIZE_BYTES держать равным VITE_FILE_MAX_SIZE_BYTES фронта.
FILE_MAX_SIZE_BYTES=15728640
VOICE_MAX_SIZE_BYTES=15728640

# --- LLM-провайдер (OpenAI) ---
# [ЗАМЕНИТЬ] на реальный ключ OpenAI.
OPENAI_API_KEY=sk-test-000000000000000000000000
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MAX_TOKENS=8192
# minimal — для Q&A у reasoning-моделей; пусто — параметр не отправляется
# (обязательно для не-reasoning моделей, например gpt-4o).
OPENAI_REASONING_EFFORT=minimal
LLM_TIMEOUT=90s
LLM_STREAM_TIMEOUT=120s

# --- gRPC-клиент к helper/ ---
GRPC_HELPER_TARGET=localhost:9090

# --- CORS: точные origin'ы фронта через запятую ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
