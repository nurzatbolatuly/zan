# Копировать в .env (локально, не коммитится — см. .gitignore) для
# docker-compose.yml. Все значения ниже — дефолты для локальной разработки,
# не для прода (BACKEND_PLAN.md §8 — секреты прода только через ENV
# хостинга/секрет-менеджер, никогда через этот файл).

ENV=dev
LOG_LEVEL=debug

POSTGRES_USER=zan
POSTGRES_PASSWORD=zan
POSTGRES_DB=zan

MINIO_ROOT_USER=zanminio
MINIO_ROOT_PASSWORD=zanminiosecret

# Stage 1 (BACKEND_PLAN.md §6 п.1, zan-backend-tz-v3.md §2.1/§2.3) — в проде
# задаются реальным секрет-менеджером/ENV хостинга, не этим файлом.
# Stage 8 (BACKEND_PLAN.md §6 "сила admin-secret и x-internal-secret"):
# backend/internal/config.validateSecrets отклоняет значения короче 32
# символов на старте, а также сами эти dev-плейсхолдеры (узнаваемы по
# конструкции — чтобы .env нельзя было случайно скопировать в прод без
# замены). Реальный секрет: `openssl rand -hex 32`.
ADMIN_TOKEN=devadmintokendevadmintokendevadmintoken1
SESSION_HMAC_SECRET=devhmacsecretchangemedevhmacsecretchangeme1

# Stage 4 (BACKEND_PLAN.md §1: "shared secret — вторая линия обороны") — общий
# секрет Go<->Python, та же оговорка про прод, что и выше.
INTERNAL_SECRET=devinternalsecretchangemedevinternalsecretchangeme1

# Stage 5 (BACKEND_PLAN.md §1.3) — пароль отдельной Postgres-роли zan_rag,
# владеющей схемой rag (заводится scripts/postgres-init/01-rag-role.sh на
# пустом томе — см. предупреждение там же про уже существующие тома).
RAG_DB_PASSWORD=devragdbpasswordchangeme

# Stage 8 (BACKEND_PLAN.md §1.3, полная изоляция core/rag) — пароль
# отдельной Postgres-роли zan_core, владеющей схемой core (заводится
# scripts/postgres-init/02-core-role.sh на пустом томе — backend/ и
# golang-migrate теперь ходят под ней, не под POSTGRES_USER/PASSWORD выше).
CORE_DB_PASSWORD=devcoredbpasswordchangeme

# Stage 5, провайдер заменён на OpenAI в Stage 8 (BACKEND_LOG.md) — без
# реального ключа стек всё равно поднимается и работает (RAG/файлы/голос не
# зависят от LLM), вызов LLM-агента предсказуемо падает на 401 (OpenAI
# отклонит ключ) — обрабатывается тем же путём, что таймаут/5xx
# (status=error, кредит возвращается на баланс), не роняет процесс.
# Подставьте реальный ключ (https://platform.openai.com/api-keys), чтобы
# агент отвечал по-настоящему.
OPENAI_API_KEY=sk-placeholder-not-a-real-key
OPENAI_MODEL=gpt-4o

# Stage 8 (BACKEND_PLAN.md §6 п.3 "Деплой") — точные origin'ы (схема+хост+
# порт) задеплоенного фронта, через запятую. Пусто в dev (SPA открывается с
# того же localhost:8080 через curl/Postman, браузерный CORS не участвует)
# — ОБЯЗАТЕЛЬНО заполнить при деплое, иначе браузер задеплоенного фронта
# заблокирует запросы к API (см. internal/httpserver.CORS).
# Пример: CORS_ALLOWED_ORIGINS=https://app.zan.kz
CORS_ALLOWED_ORIGINS=
