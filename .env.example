# Скопировать в .env и заполнить реальными значениями. Файл .env никогда не коммитится.

# OpenAI — используется всеми 4 агентами
OPENAI_API_KEY=

# PostgreSQL — используется только миграциями (ingestion/, node-pg-migrate); бэкенд ходит
# в БД через Supabase (см. ниже), напрямую не подключается.
DATABASE_URL=postgresql://user:password@localhost:5432/zan

# Supabase — backend/src/db/db.module.ts (admin-клиент через @supabase/server, secret key,
# обходит RLS — как раньше прямое подключение через DATABASE_URL)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Redis — очередь задач для оркестратора (BullMQ). Upstash и любой другой managed Redis —
# через rediss://, обычный self-hosted — через redis://.
REDIS_URL=redis://localhost:6379

# debug | info | warn | error
LOG_LEVEL=info

# Backend — порт, на котором слушает API (см. backend/src/config.ts)
PORT=3000

# Backend — origin фронтенда для CORS (Next.js dev-сервер, Этап 7)
FRONTEND_ORIGIN=http://localhost:3001

# production | development — определяет флаг Secure у cookie сессии (Этап 8, см.
# backend/src/common/session.ts) и обязателен на реальном деплое за HTTPS.
NODE_ENV=development

# Frontend — базовый URL backend API, виден в браузере (см. frontend/next.config.mjs)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
