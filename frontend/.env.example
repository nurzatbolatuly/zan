# Пример конфигурации frontend/ — тестовые значения для локальной разработки.
# Скопировать в .env (он в .gitignore, не коммитится). На хостинге те же
# переменные задаются в панели проекта. Это build-time переменные Vite:
# после смены значения на хостинге нужен redeploy, не restart.

# URL backend/ без хвостового слэша. Обязателен — без него приложение падает
# с понятной ошибкой при первом запросе (shared/lib/env.ts).
VITE_API_BASE_URL=http://localhost:8080

# true — info/debug-логи; в проде false (видны только warn/error).
VITE_ENABLE_VERBOSE_LOGS=false

# Лимит размера вложения (байты, 15 МБ) — равен FILE_MAX_SIZE_BYTES backend/.
VITE_FILE_MAX_SIZE_BYTES=15728640
