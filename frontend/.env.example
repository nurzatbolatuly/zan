# Копировать в .env (локально) — не коммитить сам .env/.env.local (см. .gitignore).
# На хостинге эти же переменные задаются в панели проекта (env vars хостинга),
# не файлом — см. instructions.md, раздел «Деплой».

# Базовый URL Go-бэкенда (backend-roadmap.md), без хвостового слэша.
# Обязателен — без него приложение намеренно падает с понятной ошибкой при
# первом запросе, а не тихо шлёт запросы на "undefined/..." (см. shared/lib/env.ts).
# Локально:
VITE_API_BASE_URL=http://localhost:8080
# Прод — пример:
# VITE_API_BASE_URL=https://api.zan.kz

# Включает info/debug-логи в проде (по умолчанию в проде видны только warn/error —
# FRONT_CODING_STANDARDS.md §4.1). Держать false на реальном проде, true — только
# для временной диагностики конкретного окружения.
VITE_ENABLE_VERBOSE_LOGS=false
